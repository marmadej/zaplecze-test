---
import fs from 'fs';
import path from 'path';

const pagesDir = path.resolve('./src/pages');

const files = fs.readdirSync(pagesDir)
  .filter(file => file.endsWith('.astro') && file !== 'index.astro');

const articles = files.map(file => {
  return {
    slug: file.replace('.astro', ''),
    title: file.replace('.astro', '').replace(/-/g, ' ')
  };
});
---

<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <title>Zaplecze SEO – szkło i kryształ</title>
    <meta name="description" content="Lista artykułów o szkle i kryształach." />
  </head>

  <body style="font-family: Arial; max-width: 800px; margin: 40px auto; line-height: 1.7;">
    <h1>Zaplecze SEO – szkło i kryształ</h1>

    <h2>Lista artykułów:</h2>

    <ul>
      {articles.map(article => (
        <li>
          <a href={`/${article.slug}`}>{article.title}</a>
        </li>
      ))}
    </ul>
  </body>
</html>