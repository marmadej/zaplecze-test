---
const { title, description } = Astro.props;
---

<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body style="font-family: Arial; max-width: 800px; margin: 40px auto; line-height: 1.7;">
    <h1>{title}</h1>

    <slot />

    <p>
      <a href="/">← Powrót na stronę główną</a>
    </p>
  </body>
</html>